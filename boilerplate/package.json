  "dependencies": {
    "@techfides/tf-doc-vault": "__VITEPRESS_COMMON_DEP__",
    "@vercel/functions": "^3.7.7"
  },
  "devDependencies": {
    "@types/node": "25.9.5",
    "@typescript-eslint/eslint-plugin": "8.67.0",
    "@typescript-eslint/parser": "8.67.0",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "mermaid": "11.17.0",
    "prettier": "3.9.6",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "vitepress": "1.6.4",
    "vitepress-plugin-mermaid": "2.0.17",
