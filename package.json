{
  "name": "@techfides/tf-doc-vault",
  "version": "0.5.0",
  "description": "Shared VitePress tooling for TFSA documentation: config factory, theme components, sidebar generator, build/export scripts, CI and Terraform module.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/TechFides/tf-doc-vault.git"
  },
  "homepage": "https://github.com/TechFides/tf-doc-vault#readme",
  "bugs": {
    "url": "https://github.com/TechFides/tf-doc-vault/issues"
  },
  "keywords": [
    "vitepress",
    "documentation",
    "tech-docs",
    "analysis-docs",
    "scaffold",
    "generator",
    "confluence",
    "markdown",
    "techfides",
    "tooling"
  ],
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.1.3",
  "private": false,
  "files": [
    "dist",
    "src",
    "configs",
    "boilerplate",
    "templates",
    "infra",
    "docker",
    "README.md",
    "LICENSE",
    "CONTRIBUTING.md",
    "SECURITY.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "typesVersions": {
    "*": {
      "config": [
        "./dist/config/index.d.ts"
      ],
      "sidebar": [
        "./dist/sidebar/index.d.ts"
      ],
      "theme": [
        "./dist/theme/index.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "default": "./dist/config/index.js"
    },
    "./sidebar": {
      "types": "./dist/sidebar/index.d.ts",
      "default": "./dist/sidebar/index.js"
    },
    "./theme": {
      "types": "./dist/theme/index.d.ts",
      "default": "./dist/theme/index.js"
    },
    "./theme/styles/*": "./dist/theme/styles/*",
    "./scripts/*": "./dist/scripts/*.js",
    "./eslint": "./configs/eslint.config.js",
    "./prettier": "./configs/prettier.json",
    "./tsconfig": "./configs/tsconfig.base.json",
    "./boilerplate/*": "./boilerplate/*",
    "./templates/*": "./templates/*",
    "./infra/terraform": "./infra/terraform",
    "./docker/Dockerfile": "./docker/Dockerfile",
    "./docker/nginx.conf": "./docker/nginx.conf",
    "./docker/nginx-auth.conf": "./docker/nginx-auth.conf",
    "./package.json": "./package.json"
  },
  "bin": {
    "tf-doc-vault": "./dist/cli/tf-doc-vault.js"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "dev:docs": "vitepress dev playground/docs",
    "build:docs": "vitepress build playground/docs",
    "preview:docs": "vitepress preview playground/docs",
    "prepare": "node scripts/build.mjs && lefthook install --reset-hooks-path",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --config configs/eslint.config.js src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "licence-check": "tf-licence-checker --config=licence-checker.config.cjs",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage",
    "test:smoke": "playwright test",
    "test": "pnpm test:unit && pnpm test:smoke",
    "release": "changelogen --release --no-github"
  },
  "peerDependencies": {
    "mermaid": "^11.14.0",
    "vitepress": "^1.6.4",
    "vitepress-plugin-mermaid": "^2.0.17",
    "vue": "^3.5.33"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "extended-markdown-adf-parser": "2.4.0",
    "markdown-it-container": "^4.0.0",
    "markdownlint": "^0.40.0",
    "playwright": "^1.59.1",
    "vue-i18n": "^11.4.4"
  },
  "devDependencies": {
    "@commitlint/cli": "21.0.1",
    "@commitlint/config-conventional": "21.0.1",
    "@playwright/test": "1.60.0",
    "@types/markdown-it-container": "4.0.0",
    "@types/node": "25.6.2",
    "@typescript-eslint/eslint-plugin": "8.59.2",
    "@typescript-eslint/parser": "8.59.2",
    "@vercel/functions": "3.7.7",
    "@vitest/coverage-v8": "3.2.4",
    "changelogen": "0.6.2",
    "eslint": "10.3.0",
    "eslint-config-prettier": "10.1.8",
    "knip": "6.24.0",
    "lefthook": "2.1.10",
    "mermaid": "11.16.1",
    "prettier": "3.8.3",
    "tf-licence-checker": "1.1.9",
    "tsx": "4.21.0",
    "typescript": "6.0.3",
    "vitepress": "1.6.4",
    "vitepress-plugin-mermaid": "2.0.17",
    "vitest": "3.2.4",
    "vue": "3.5.34"
  }
}
