    {
      "type": "heading",
      "attrs": { "level": 1 },
      "content": [{ "text": "Open telemetry v nest.js", "type": "text" }]
    },
    {
      "type": "heading",
      "attrs": { "level": 2 },
      "content": [{ "text": "Install", "type": "text" }]
    },
    {
      "type": "codeBlock",
      "content": [
        {
          "text": "npm i nestjs-otel\nnpm i @techfides/nestjs-common-opentelemetry",
          "type": "text"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [{ "text": "see ", "type": "text" }]
    },
    {
      "type": "blockCard",
      "attrs": {
        "url": "https://techfides.atlassian.net/wiki/spaces/TP/pages/4002349136"
      }
    },
    {
      "type": "paragraph",
      "content": [{ "text": " ", "type": "text" }]
    },
    {
      "type": "heading",
      "attrs": { "level": 2 },
      "content": [{ "text": "main.ts", "type": "text" }]
    },
    {
      "type": "codeBlock",
      "attrs": { "language": "typescript" },
      "content": [
        {
          "text": "import { createOtelSDK } from '@techfides/nestjs-common-opentelemetry';\n\nconst otelSDK = createOtelSDK(\n  'tf-ios',\n  'http://jaeger-otpl.jaeger.svc.cluster.local:4318/v1/traces',\n);",
          "type": "text"
        }
      ]
    },
    {
      "type": "heading",
      "attrs": { "level": 2 },
      "content": [{ "text": "app.module.ts", "type": "text" }]
    },
    {
      "type": "paragraph",
      "content": [{ "text": "importovat module", "type": "text" }]
    },
    {
      "type": "codeBlock",
      "attrs": { "language": "typescript" },
      "content": [
        {
          "text": "OpenTelemetryModule.forRoot({\n  metrics: {\n    hostMetrics: true, // Includes Host Metrics\n    apiMetrics: {\n      enable: true, // Includes api metrics\n      ignoreRoutes: ['health/'],\n      ignoreUndefinedRoutes: false,\n    },\n  },\n}),",
          "type": "text"
        }
      ]
    },
    {
      "type": "heading",
      "attrs": { "level": 1 },
      "content": [
        { "text": "Aktuální stav implementace trackování", "type": "text" }
      ]
