# Hoist mermaid + jeho transitivní CJS závislosti do node_modules root.
# Bez toho Vite (vitepress) nemůže pre-bundlovat dayjs/debug/cytoscape/...
# a klient padne s "does not provide an export named 'default'".
public-hoist-pattern[]=*mermaid*
public-hoist-pattern[]=dayjs
public-hoist-pattern[]=debug
public-hoist-pattern[]=@braintree/*
public-hoist-pattern[]=cytoscape*
public-hoist-pattern[]=@types/d3*
public-hoist-pattern[]=d3-*
