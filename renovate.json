{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":semanticCommits",
    ":semanticCommitTypeAll(chore)",
    "security:minimumReleaseAgeNpm",
    "group:allNonMajor"
  ],
  "labels": ["dependencies"],
  "schedule": ["before 6am on monday"],
  "automergeSchedule": ["after 7am and before 11am on monday"],
  "platformAutomerge": false,
  "packageRules": [
    {
      "description": "Auto-merge low-risk updates once CI is green. Major updates stay manual for human review.",
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "bump"],
      "automerge": true
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "schedule": ["before 6am on monday"]
  }
}
