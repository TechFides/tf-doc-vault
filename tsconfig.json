{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    "outDir": "./dist",
    "rootDir": "./src",
    "types": ["node"],
    "jsx": "preserve"
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "node_modules",
    "template",
    "dist",
    "src/**/*.vue",
    "src/**/*.css"
  ]
}
